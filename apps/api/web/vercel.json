{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/auth/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tendrils-crm.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://tendrils-crm.onrender.com/auth/:path*" },
    { "source": "/health", "destination": "https://tendrils-crm.onrender.com/health" },
    { "source": "/((?!api/|auth/).*)", "destination": "/index.html" }
  ]
}