generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  accounts Account[]
  sessions Session[]
  memberships Membership[]
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks Task[] @relation("TaskCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")
  requestedTickets Ticket[] @relation("TicketRequester")
  comments Comment[]
  notifications Notification[]
  activityLogs ActivityLog[]
  projectMemberships ProjectMember[]
  taskAssignments TaskAssignee[]
  chatMessages ChatMessage[]
  chatReads ChatRead[]
  dailyUpdates DailyUpdate[]
  privateNotes PrivateNote[]
  reminders Reminder[]
  invitationsSent Invitation[] @relation("InvitedBy")
  projectUpdates ProjectUpdate[]
  documents Document[]
  chatDeliveries ChatDelivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([provider,providerAccountId])
}
model Session {
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([sessionToken])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@id([identifier,token])
}
enum OrgType {
  INTERNAL
  CLIENT
}
enum MemberRole {
  PLATFORM_ADMIN
  MANAGER
  EMPLOYEE
  CLIENT_ADMIN
  CLIENT_MEMBER
}
enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}
enum TicketStatus {
  OPEN
  REVIEW_TEST
  REVIEW_HELP
  CLOSED
}

enum TicketProgress {
  IN_PROGRESS
  QA
  NEED_MORE_INFO
  RESOLVED
}
enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum Visibility {
  INTERNAL
  CLIENT
}
enum NotificationType {
  ASSIGNMENT
  COMMENT
  MENTION
  DUE_SOON
  OVERDUE
  STATUS_CHANGE
  APPROVAL
  SYSTEM
}
model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  type OrgType @default(CLIENT)
  isActive Boolean @default(true)
  memberships Membership[]
  projects Project[]
  tickets Ticket[]
  tasks Task[]
  teams Team[]
  invitations Invitation[]
  documents Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Membership {
  id String @id @default(cuid())
  userId String
  organizationId String
  role MemberRole @default(EMPLOYEE)
  isActive Boolean @default(true)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  teamMemberships TeamMember[]
  @@unique([userId,organizationId])
  @@index([organizationId,role])
}
model Team {
  id String @id @default(cuid())
  name String
  slug String
  description String?
  isActive Boolean @default(true)
  clientVisible Boolean @default(true)
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  projectLinks ProjectTeam[]
  members TeamMember[]
  tasks Task[]
  ticketAccesses TicketTeamAccess[]
  taskAccesses TaskTeamAccess[]
  createdAt DateTime @default(now())
  @@unique([organizationId,slug])
}
model TeamMember {
  teamId String
  membershipId String
  team Team @relation(fields:[teamId],references:[id],onDelete:Cascade)
  membership Membership @relation(fields:[membershipId],references:[id],onDelete:Cascade)
  @@id([teamId,membershipId])
}
model Project {
  id String @id @default(cuid())
  organizationId String
  name String
  description String? @db.Text
  status ProjectStatus @default(PLANNING)
  startDate DateTime?
  dueDate DateTime?
  ownerId String?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  tickets Ticket[]
  tasks Task[]
  requestedByClient Boolean @default(false)
  attachments Attachment[]
  teams ProjectTeam[]
  members ProjectMember[]
  chatRoom ChatRoom?
  updates ProjectUpdate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,status])
}
model Ticket {
  id String @id @default(cuid())
  key String @unique
  organizationId String
  projectId String?
  title String
  description String? @db.Text
  status TicketStatus @default(OPEN)
  progress TicketProgress?
  closedAt DateTime?
  priority Priority @default(MEDIUM)
  visibility Visibility @default(CLIENT)
  requesterId String?
  assigneeId String?
  teamId String?
  dueDate DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  requester User? @relation("TicketRequester",fields:[requesterId],references:[id],onDelete:SetNull)
  assignee User? @relation("TicketAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  comments Comment[]
  attachments Attachment[]
  tasks Task[]
  teamAccesses TicketTeamAccess[]
  events TicketEvent[]
  reminders Reminder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,status,priority])
}
model Task {
  completedAt DateTime?
  id String @id @default(cuid())
  organizationId String
  projectId String?
  ticketId String?
  teamId String?
  autoCreated Boolean @default(false)
  parentId String?
  title String
  description String? @db.Text
  status TaskStatus @default(TODO)
  priority Priority @default(MEDIUM)
  assigneeId String?
  creatorId String?
  dueDate DateTime?
  position Int @default(0)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  ticket Ticket? @relation(fields:[ticketId],references:[id],onDelete:SetNull)
  team Team? @relation(fields:[teamId],references:[id],onDelete:SetNull)
  teamAccesses TaskTeamAccess[]
  assignee User? @relation("TaskAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  creator User? @relation("TaskCreator",fields:[creatorId],references:[id],onDelete:SetNull)
  parent Task? @relation("Subtasks",fields:[parentId],references:[id],onDelete:Cascade)
  subtasks Task[] @relation("Subtasks")
  assignees TaskAssignee[]
  comments Comment[]
  attachments Attachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ticketId,autoCreated])
  @@index([teamId,status])
  @@index([organizationId,status,dueDate])
}
// Explicit ticket participation boundary: only listed teams can discover/read the ticket.
model TicketTeamAccess {
  ticketId String
  teamId String
  accessRole String @default("PARTICIPANT") // ORIGIN, OWNER, PARTICIPANT
  addedById String?
  createdAt DateTime @default(now())
  ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  team Team @relation(fields:[teamId],references:[id],onDelete:Cascade)
  @@id([ticketId,teamId])
  @@index([teamId,ticketId])
}

// Explicit team access for independent tasks and subtasks. Ticket-linked tasks inherit
// the ticket's team boundary and may additionally be restricted to participating teams.
model TaskTeamAccess {
  taskId String
  teamId String
  accessRole String @default("PARTICIPANT")
  addedById String?
  createdAt DateTime @default(now())
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  team Team @relation(fields:[teamId],references:[id],onDelete:Cascade)
  @@id([taskId,teamId])
  @@index([teamId,taskId])
}

model Comment {
  id String @id @default(cuid())
  body String @db.Text
  visibility Visibility @default(INTERNAL)
  authorId String
  ticketId String?
  taskId String?
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  ticket Ticket? @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  task Task? @relation(fields:[taskId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
}
model Attachment {
  id String @id @default(cuid())
  originalName String
  storageKey String @unique
  mimeType String
  size Int
  uploadedById String
  ticketId String?
  taskId String?
  projectId String?
  inline Boolean @default(false) // pasted into a description/comment: shown inline, not in the Files list
  ticket Ticket? @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  task Task? @relation(fields:[taskId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([ticketId])
  @@index([taskId])
  @@index([projectId])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  body String
  href String?
  readAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([userId,readAt,createdAt])
}
model ActivityLog {
  id String @id @default(cuid())
  actorId String?
  organizationId String?
  entityType String
  entityId String
  action String
  summary String
  metadata Json?
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
}
enum ProjectRole {
  LEAD
  MEMBER
}
enum RoomType {
  GENERAL
  PROJECT
  DIRECT
}
model ProjectMember {
  projectId String
  userId String
  role ProjectRole @default(MEMBER)
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([projectId,userId])
  @@index([userId])
}
model TaskAssignee {
  taskId String
  userId String
  createdAt DateTime @default(now())
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([taskId,userId])
  @@index([userId])
}
model ChatRoom {
  id String @id @default(cuid())
  name String
  type RoomType @default(PROJECT)
  projectId String? @unique
  directKey String? @unique
  project Project? @relation(fields:[projectId],references:[id],onDelete:Cascade)
  messages ChatMessage[]
  reads ChatRead[]
  deliveries ChatDelivery[]
  createdAt DateTime @default(now())
  @@index([type])
}
model ChatMessage {
  id String @id @default(cuid())
  roomId String
  authorId String
  body String @db.Text
  mentionIds String[] @default([])
  editedAt DateTime?
  deletedAt DateTime?
  pinnedAt DateTime?
  pinnedById String?
  replyToId String?
  replyTo ChatMessage? @relation("Replies",fields:[replyToId],references:[id],onDelete:SetNull)
  replies ChatMessage[] @relation("Replies")
  room ChatRoom @relation(fields:[roomId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([roomId,createdAt])
  @@index([roomId,pinnedAt])
  @@index([replyToId])
}
model DailyUpdate {
  id String @id @default(cuid())
  userId String
  date DateTime @db.Date
  yesterday String @db.Text
  today String @db.Text
  blockers String? @db.Text
  projectId String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId,date])
  @@index([date])
}
model ChatRead {
  roomId String
  userId String
  lastReadAt DateTime @default(now())
  room ChatRoom @relation(fields:[roomId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([roomId,userId])
  @@index([userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}
// Email invitation. Accepted automatically when the invited person signs in with a Google account whose
// VERIFIED email matches. A partial unique index (see migration) allows one PENDING invite per email + workspace.
model Invitation {
  id String @id @default(cuid())
  email String
  organizationId String
  role MemberRole
  teamIds String[] @default([])
  status InviteStatus @default(PENDING)
  invitedById String?
  expiresAt DateTime
  lastSentAt DateTime @default(now())
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  invitedBy User? @relation("InvitedBy",fields:[invitedById],references:[id],onDelete:SetNull)
  @@index([email,status])
  @@index([organizationId,status])
}
// Client-facing progress post on a project (visible to that client's users).
model ProjectUpdate {
  id String @id @default(cuid())
  projectId String
  authorId String
  title String
  body String @db.Text
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  @@index([projectId,createdAt])
}
// Per-room "delivered" marker (WhatsApp double tick). "Read" lives in ChatRead.
model ChatDelivery {
  roomId String
  userId String
  deliveredAt DateTime @default(now())
  room ChatRoom @relation(fields:[roomId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([roomId,userId])
  @@index([userId])
}

model Document {
  id String @id @default(cuid())
  title String
  originalName String
  storageKey String @unique
  mimeType String
  size Int
  category String @default("GENERAL")
  visibility Visibility @default(INTERNAL)
  organizationId String?
  uploadedById String
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, visibility, createdAt])
}

// Per-ticket history (who changed what, when). Separate from ActivityLog (the org-wide audit feed).
// Labels are stored as text so the history stays readable after users/teams are renamed or removed.
model TicketEvent {
  id String @id @default(cuid())
  ticketId String
  actorId String?
  type String // CREATED, STATUS, PRIORITY, ASSIGNEE, TEAM, TEAM_ACCESS, TITLE, DESCRIPTION, DUE_DATE, VISIBILITY, PROJECT, COMMENT, ATTACHMENT
  fromValue String?
  toValue String?
  fromLabel String?
  toLabel String?
  note String?
  clientVisible Boolean @default(false)
  createdAt DateTime @default(now())
  ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  @@index([ticketId,createdAt])
}

// Personal notes: visible ONLY to their author. Never emailed, never notified, never written to ActivityLog,
// and there is intentionally no admin/manager route that reads this table.
model PrivateNote {
  id String @id @default(cuid())
  userId String
  date DateTime @db.Date
  title String?
  body String @db.Text
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,date])
}

// Personal flags and reminders (staff only). A flag is a reminder with flagged=true and no remindAt.
model Reminder {
  id String @id @default(cuid())
  userId String
  ticketId String?
  title String
  remindAt DateTime?
  flagged Boolean @default(false)
  notifiedAt DateTime?
  doneAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  ticket Ticket? @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,doneAt])
  @@index([remindAt,notifiedAt])
}

// Remembers one-time jobs (like the demo seed) so they never run twice on the same database.
model SeedMarker {
  key String @id
  ranAt DateTime @default(now())
}

// Which internal teams a project is for (chosen by the client when requesting it, or by staff when creating it).
model ProjectTeam {
  projectId String
  teamId String
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  team Team @relation(fields:[teamId],references:[id],onDelete:Cascade)
  @@id([projectId,teamId])
  @@index([teamId])
}
