DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tendrils_crm?schema=public"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:4000/auth"
WEB_ORIGIN="http://localhost:5173"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Tendrils Operations <no-reply@tendrils.io>"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="15"

# --- Added: required/optional for auth redirects and admin linking ---
WEB_URL="http://localhost:5173"
# Google account email of the FIRST Platform admin (any domain). Run `npm run link-admin` once after seeding.
ADMIN_EMAIL=""
# Email invitations stay valid this many days.
INVITE_EXPIRY_DAYS="7"
NODE_ENV="development"

# Local testing only: enables "DEV LOGIN" for seeded demo users (npm run seed:demo). Keep false in production.
DEV_LOGIN="false"

# Chat encryption key: generate 32 random bytes encoded as base64 before enabling encrypted-at-rest chat.
# CHAT_ENCRYPTION_KEY=
