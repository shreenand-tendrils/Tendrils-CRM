{
  "name": "tendrils-operations-platform",
  "version": "4.8.24",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "db:generate": "npm --workspace apps/api run db:generate",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:deploy": "npm --workspace apps/api run db:deploy",
    "db:seed": "npm --workspace apps/api run db:seed",
    "db:studio": "npm --workspace apps/api run db:studio",
    "build": "npm --workspace apps/web run build",
    "test": "npm --workspace apps/api run test",
    "check": "npm run db:validate --workspace apps/api && npm run test && npm run build",
    "smoke": "npm --workspace apps/api run smoke",
    "backfill:tasks": "npm --workspace apps/api run backfill:tasks",
    "db:fresh": "npm --workspace apps/api run db:fresh",
    "db:reset-demo": "npm --workspace apps/api run db:fresh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
